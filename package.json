{
  "name": "@kamaalio/joi-to-zod-codemod",
  "version": "0.0.1",
  "description": "",
  "keywords": [],
  "bugs": "https://github.com/kamaal111/joi-to-zod-codemod/issues",
  "license": "MIT",
  "author": "Kamaal Farah",
  "repository": "kamaal111/joi-to-zod-codemod",
  "bin": {
    "joi-to-zod-codemod": "./bin/run.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:example": "vitest run --config example/vitest.config.ts example/",
    "test:u": "vitest run --update",
    "build": "pnpm run compile",
    "clean:build": "rm -rf dist tsconfig.tsbuildinfo && pnpm run build",
    "compile": "tsc",
    "type-check": "tsc --noEmit",
    "type-check:test": "tsc --noEmit --project tsconfig.test.json",
    "type-check:example": "tsc --noEmit --project example/tsconfig.json",
    "lint": "oxlint",
    "lint:example": "oxlint example/",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.45.1",
    "@kamaalio/codemod-kit": "^0.0.45",
    "@kamaalio/kamaal": "^0.9.11"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "joi": "^18.2.4",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": "pnpm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
